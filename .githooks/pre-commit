#!/usr/bin/env bash
#
# RunOS pre-commit hook: keep internal identifiers and credentials out of this
# PUBLIC repo. This file is IDENTICAL in every public RunOS repo.
#
# It is TRACKED, because .git/hooks is not. A hook that lives only in one clone
# is a hook nobody has. Install it once per clone with:
#
#     make hooks          (or: git config core.hooksPath .githooks)
#
# It scans ONLY the staged diff, so it stays fast, and it is the FIRST of three
# run points, not the last one:
#
#   1. this hook                          opt-in, skippable, fast
#   2. .github/workflows/leakcheck.yml    every push and every pull request,
#                                         whole tree, cannot be skipped
#   3. scripts/release.sh                 the release gate, whole tree
#
# All three run points also run scripts/unscannable_check.py, which makes a
# tracked file leakcheck cannot read a hard failure rather than a quiet partial
# scan. leakcheck reads UTF-8 text; other encodings it reads best effort or not
# at all, so an unreadable tracked file is a hole in all three.
#
# A fresh clone has core.hooksPath unset, so it has no hook at all until
# somebody runs `make hooks`. Run point 2 is what actually holds the line.
#
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECKER="$REPO_ROOT/scripts/leakcheck.py"

[[ -f "$CHECKER" ]] || exit 0

if ! command -v python3 >/dev/null 2>&1; then
  printf '\033[0;33m  !\033[0m pre-commit: python3 not found, leakcheck skipped. The release gate still runs it.\n' >&2
  exit 0
fi

# leakcheck can only fully read UTF-8 text. Up to checker 1.1.0 it SKIPPED
# anything else in silence: read_text() returned None and scan_files() just
# continued. From 1.2.0 it recovers printable runs from the raw bytes, which is
# best effort and not a scan. Measured on 1.2.0: a token in a UTF-32 file, and a
# token broken up by NUL bytes, both passed with exit 0. So run the scannability
# gate FIRST, or such a file walks straight past the line below.
UNSCANNABLE="$REPO_ROOT/scripts/unscannable_check.py"
if [[ -f "$UNSCANNABLE" ]]; then
  if ! OUTPUT="$(python3 "$UNSCANNABLE" 2>&1)"; then
    printf '%s\n' "$OUTPUT" >&2
    printf '\n  COMMIT BLOCKED: a tracked file is one leakcheck cannot read.\n\n' >&2
    exit 1
  fi
fi

if OUTPUT="$(python3 "$CHECKER" --staged 2>&1)"; then
  exit 0
fi
printf '%s\n' "$OUTPUT" >&2

cat >&2 <<'MSG'

  --------------------------------------------------------------------------
  COMMIT BLOCKED by leakcheck. This is a PUBLIC repo.

  Fix the lines above. Do not hand-add them to scripts/leakcheck.baseline:
  that file records leaks that already shipped, it is not a way through.

  In a real emergency, and only then, skip this hook the normal git way:

      git commit --no-verify

  Skipping does NOT get the change onto GitHub clean. The Leak gate workflow
  runs the same checker over the whole tree on every push and every pull
  request, and scripts/release.sh runs it again. Neither can be skipped.
  --------------------------------------------------------------------------

MSG
exit 1
